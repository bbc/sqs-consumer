from html.parser import HTMLParser
from pathlib import Path
import re

class Ids(HTMLParser):
    def __init__(self):
        super().__init__()
        self.ids = set()

    def handle_starttag(self, tag, attrs):
        self.ids.update(value for key, value in attrs if key == "id")

public = Path("public")
index = public / "index.html"
assert index.is_file(), index
assert "SQS Consumer" in index.read_text(), index
links = set(re.findall(r'https://bbc\.github\.io/sqs-consumer/([^\s)]+\.html)(?:#([\w-]+))?', Path("README.md").read_text()))
assert links
for page, anchor in sorted(links):
    path = public / page
    assert path.is_file(), path
    if anchor:
        reader = Ids()
        reader.feed(path.read_text())
        assert anchor in reader.ids, (path, anchor)
    print(f"Verified {page}" + (f"#{anchor}" if anchor else ""))
PY
